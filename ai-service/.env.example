# --- LifeTrack AI service configuration -------------------------------------
# Pick a provider; AI_BASE_URL defaults are derived from it but can be overridden.
#   lmstudio | openai | mistral | gemini
AI_PROVIDER=lmstudio

# Override the base URL when needed (LM Studio on another host, a proxy, etc.).
#   lmstudio default : http://localhost:1234/v1
#   openai           : https://api.openai.com/v1
#   mistral          : https://api.mistral.ai/v1
#   gemini           : https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=http://localhost:1234/v1

# API key for the chosen provider. LM Studio may accept any value.
AI_API_KEY=

# Default model. Leave blank and call GET /models to discover options,
# then pass {"model": "..."} per request.
AI_MODEL=

# Generation tuning
AI_TEMPERATURE=0.4
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=800

# --- Local vector DB (optional) ---------------------------------------------
# Default context strategy for /chat:
#   full         -> caller sends full context (no embeddings, current behaviour)
#   local_vector -> embed query locally + retrieve top-k journal snippets
AI_RETRIEVAL_MODE=full
# Local embedding model id (as listed by GET /models on the provider).
EMBEDDING_MODEL=text-embedding-nomic
VECTOR_DATA_DIR=./data/users
VECTOR_TOP_K=5
VECTOR_CACHE_USERS=16
VECTOR_BIT_WIDTH=4
VECTOR_BACKEND=auto          # auto | turbovec | numpy
USER_KEY_SALT=change-me-local
MAX_SNIPPET_CHARS=500

# CORS (React dev servers)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
